{
  "name": "nivaran-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx tests/verify-engine.ts",
    "test:backend": "python -m pytest backend/tests/ -v",
    "test:all": "tsx tests/verify-engine.ts && python -m pytest backend/tests/ -v",
    "backend": "python -m uvicorn backend.app.main:app --port 8000 --reload",
    "seed": "python -c \"from backend.app.db.database import init_db, SessionLocal; from backend.app.db.seed import seed_all_stocks, seed_demo_investor; init_db(); db = SessionLocal(); seed_all_stocks(db); seed_demo_investor(db); db.close(); print('Seed complete')\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
